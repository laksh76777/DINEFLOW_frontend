# =========================================
# DINEFLOW - Root Git Ignore
# =========================================

# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak

# Production & Transpiled Builds
dist/
build/
out/
*/dist/
*/build/
frontend/dist/
backend/dist/
frontend/.vite/
backend/.cache/
/figma

# Environment Variables & Secrets
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example

# Service Accounts & Credentials
firebase-adminsdk*.json
serviceAccountKey.json
service-account*.json
credentials.json
secrets.json
secrets.local.json
*.pem
*.key
*.crt
*.p12
*.pfx

# Runtime Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/
*.lcov

# IDE & Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.iml
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary & Swap Files
*.tmp
*.temp
*.swp
*.swo
*~
.cache/
*/.cache/

# User Uploads & Local Media Storage
backend/uploads/*
!backend/uploads/.gitkeep
backend/storage/*
!backend/storage/.gitkeep
frontend/uploads/*
!frontend/uploads/.gitkeep

# Deployment Providers
.vercel/
.render/
.railway/
